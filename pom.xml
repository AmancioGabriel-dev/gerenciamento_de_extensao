<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- O parent do Spring Boot traz versoes ja testadas de todas as dependencias.
         Voce nao precisa decorar numeros de versao: o parent cuida disso. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.extensao</groupId>
    <artifactId>gerenciamento-de-extensao</artifactId>
    <version>1.0.0</version>
    <name>gerenciamento-de-extensao</name>
    <description>Sistema de Gerenciamento de Extensao - Etapa 3 (Spring Boot)</description>

    <properties>
        <!-- Compilamos mirando Java 21 (LTS suportada pelo Spring Boot 3.3),
             mesmo que a JDK instalada seja mais nova. -->
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Web: cria os endpoints REST e sobe o servidor Tomcat embutido -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA: mapeia as entidades para tabelas e gera o SQL pra voce -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation: valida os dados que chegam nos endpoints (@NotBlank, @Min...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- H2: banco em memoria. Zero instalacao, reseta a cada reinicio. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Ferramentas de teste do Spring (JUnit, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin que empacota tudo num JAR executavel e roda "mvn spring-boot:run" -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
